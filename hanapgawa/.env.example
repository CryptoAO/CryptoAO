# Copy to .env for local development.

# SQLite for dev. Production: postgresql://user:pass@host:5432/hanapgawa
DATABASE_URL="file:./dev.db"

# Session signing secret. MUST be a long random string in production
# (e.g. `openssl rand -base64 48`). The app refuses to start in production
# without it.
SESSION_SECRET="dev-only-secret-change-me"

# "dev" logs OTP codes to the server console instead of sending SMS.
# Production: set to "semaphore" (or another adapter in src/lib/sms.ts)
# and provide the API key.
SMS_PROVIDER="dev"
SEMAPHORE_API_KEY=""

# "dev" makes wallet top-ups instant fake credits.
# Production: set to "paymongo" and provide keys (GCash/Maya/card via PayMongo).
PAYMENTS_PROVIDER="dev"
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Where identity documents are written in dev. Must NOT be web-servable.
# Production: swap src/lib/storage.ts for an S3/R2 bucket with public
# access blocked.
PRIVATE_STORAGE_DIR=""

# Error monitoring. Empty = structured JSON to stdout only.
# Production: a Sentry-compatible DSN.
SENTRY_DSN=""
APP_RELEASE=""

# Shared rate-limit store. Empty = per-instance in-memory counters, which is
# correct for a single node. Once the app runs behind more than one instance,
# set this (and `npm i ioredis`) or every limit is silently multiplied by the
# number of servers.
REDIS_URL=""
